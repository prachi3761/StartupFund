{
  "name": "startupfund-server",
  "version": "1.0.0",
  "description": "StartupFund API server - Express.js + Mongoose + MongoDB",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
